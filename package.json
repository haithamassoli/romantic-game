{
  "name": "romantic-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
